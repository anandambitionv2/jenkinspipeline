pipeline {
    agent any

    stages {
        stage('Example') {
            // agent {
            //     label 'mycustomtf'
            // }

            steps {
                echo 'Hello World'
                sh 'hostname'
               
               
            }
        }
        stage('terraforminitstage') {
            agent {
                label 'mycustomtf'
            }

            steps { container('mycustomtf-sidecar') {
                echo 'Hello World'
                sh 'hostname'
                
                sh "terraform init"
                sh "terraform plan"
                sleep 60
               
            }
            
        
        }
    }
}
}